# Local environment example — copy to .env.local and fill values
# Do NOT commit your real API keys into version control.

# Anthropic API key (server-only)
# ANTHROPIC_API_KEY=sk-...

# Anthropic Claude model ID — set to the exact model name your account supports.
# Replace with the exact model id, for example: claude-3, claude-2, etc.
# Do NOT guess; confirm in your Anthropic account or with support.
ANTHROPIC_MODEL=REPLACE_WITH_AN_ANTHROPIC_MODEL_ID

# ElevenLabs keys (example)
# ELEVENLABS_API_KEY=sk_...
# ELEVENLABS_VOICE_ID=...
