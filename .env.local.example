# Local environment example — copy to .env.local and fill values
# Do NOT commit your real API keys into version control.

# Anthropic API key (server-only)
# ANTHROPIC_API_KEY=sk-...

# Anthropic Claude model ID — set to the exact model name your account supports.
# Replace with the exact model id, for example: claude-3, claude-2, etc.
# Do NOT guess; confirm in your Anthropic account or with support.
ANTHROPIC_MODEL=REPLACE_WITH_AN_ANTHROPIC_MODEL_ID

# Memory Library: Name of the person represented by this AI
# Used in system prompts and personal memory context
REPRESENTED_PERSON_NAME=this person

# ElevenLabs keys (example)
# ELEVENLABS_API_KEY=sk_...
# ELEVENLABS_VOICE_ID=...

# AgentMail integration (server-only)
# AGENTMAIL_API_KEY=am_...
# AGENTMAIL_INBOX_ID=your-inbox@agentmail.to
# AGENTMAIL_WEBHOOK_SECRET=whsec_...

# OpenClaw Gateway (server-only)
# Enable OpenClaw computer-control actions
# OPENCLAW_ENABLED=true
# OpenClaw Gateway WebSocket/HTTP URL (usually ws://127.0.0.1:18789)
# OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789
# OpenClaw authentication token (keep this secret, server-side only)
# OPENCLAW_GATEWAY_TOKEN=your_openclaw_token_here

# Square Terminal integration (server-side only)
# SQUARE_ACCESS_TOKEN=EAAA...
# SQUARE_LOCATION_ID=your_square_location_id
# SQUARE_ENVIRONMENT=production
# SQUARE_WEBHOOK_SIGNATURE_KEY=base64_or_signature_key_from_square
# SQUARE_WEBHOOK_NOTIFICATION_URL=https://your-domain.com/api/webhooks/square

# Front-desk presence detection (client-side)
# NEXT_PUBLIC_FRONT_DESK_MODE=true
# NEXT_PUBLIC_FRONT_DESK_SIMULATE_PERSON=false
# NEXT_PUBLIC_FRONT_DESK_PERSON_CONFIRMATION_MS=1000
# NEXT_PUBLIC_FRONT_DESK_PERSON_ABSENCE_MS=5000
# NEXT_PUBLIC_FRONT_DESK_GREETING_COOLDOWN_MS=10000
# NEXT_PUBLIC_FRONT_DESK_DETECTION_INTERVAL_MS=700
# NEXT_PUBLIC_FRONT_DESK_PERSON_CONFIDENCE_THRESHOLD=0.65
# NEXT_PUBLIC_FRONT_DESK_CAMERA_WIDTH=640
# NEXT_PUBLIC_FRONT_DESK_CAMERA_HEIGHT=360
# NEXT_PUBLIC_FRONT_DESK_CAMERA_RECONNECT_MS=5000
